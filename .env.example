# Copy to .env and fill in your own keys. Never commit .env.
# LLM provider (Groq free tier): https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Embeddings provider (Google AI Studio free tier): https://aistudio.google.com
GOOGLE_API_KEY=
EMBEDDING_MODEL=models/gemini-embedding-001
# Vector store (Pinecone free Starter plan): https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX_NAME=rag-assistant
# Chunking defaults
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
